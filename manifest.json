{
  "manifest_version": 3,
  "name": "Voice Changer for WhatsApp Web",
  "short_name": "WA Voice Changer",
  "version": "1.0.0",
  "description": "Change your voice live during WhatsApp Web calls and voice notes: pitch, formant, robot, echo, reverb and 30 presets. Runs fully in your browser.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Voice Changer for WhatsApp Web",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "src/shared/params.js",
        "src/engine/dsp-core.js",
        "src/engine/voice-engine.js",
        "src/content/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content/bridge.js", "src/content/voicenote-ui.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/engine/dsp-core.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "commands": {
    "toggle-voice": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Turn the voice changer on or off"
    },
    "next-preset": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Switch to the next voice preset"
    }
  }
}
